---
import MainLayout from '@/layouts/MainLayout.astro'
import site from '@/site.config'
---

<MainLayout title={`Friends | ${site.title}`} description="Friends of tasky">
  <Fragment slot="title">
    <div class="flex flex-col">
      <h2 class="font-semibold text-2xl">Friends</h2>
    </div>
  </Fragment>

  <Fragment slot="article">
    <p>Some friends and cool folks:</p>
    <img
      src="https://sketchni.uk/images/sketch.png"
      alt="SketchNI"
      title="SketchNI"
    />
  </Fragment>
</MainLayout>
